# First boot options (pick one):
#   A) Docker: leave ADMIN_PASSWORD / SESSION_SECRET empty — the entrypoint
#      writes random values once to ./data/admin-credentials.txt and ./data/.env
#      (never overwritten). Read the credentials file for the admin password.
#   B) Host helper: ./scripts/gen-env.sh  → creates this .env + ./data/admin-credentials.txt once
#   C) Set your own strong ADMIN_PASSWORD (and SESSION_SECRET) here before first start
#
# After the DB exists, change the password in Settings → Change password
# (editing ADMIN_PASSWORD here will not update an existing admin).
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
SECURE_COOKIES=true
THUMB_VAAPI=false
# auto|off|vaapi|nvdec — empty defers to THUMB_VAAPI (true means auto)
# THUMB_HWACCEL=auto
# Docker only: host UID/GID for /data (default 1000:1000)
# PUID=1000
# PGID=1000
# UMASK=002
# Public HTTPS deployments must set both of these:
# SECURE_COOKIES=true
# PUBLIC_BASE_URL=https://filehub.example.com
# If the reverse proxy is not on loopback, also set:
# TRUSTED_PROXIES=10.0.0.0/8
# LOGIN_RATE_LIMIT=10
# LOGIN_LOCKOUT_LIMIT=10
# LOGIN_LOCKOUT_MINUTES=15
# Max upload size in MiB (default 102400 = 100 GiB). Set 0 to disable the
# application cap; user and storage quotas still apply. The web UI uses
# chunked uploads for files of 1 MiB or more.
# MAX_UPLOAD_MB=102400
# HSTS should be set on the reverse proxy, not in Filehub.
# Optional SMTP env overrides (take precedence over System → Email settings)
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# WebDAV is on by default at /dav/. Set false to disable.
# WEBDAV_ENABLED=true
