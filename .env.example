ADMIN_USER=admin
ADMIN_PASSWORD=replace-me
SESSION_SECRET=replace-with-long-random-string
SECURE_COOKIES=true
THUMB_VAAPI=false
# Optional: public URL used in password-reset emails (otherwise request Host is used)
# PUBLIC_BASE_URL=https://filehub.example.com
# Optional SMTP env overrides (take precedence over System → Email settings)
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
